spk_forgot:'Unpaired.',spk_unknown:'(no name)',spk_unavail:'Bluetooth service not reachable.',spk_pair_failed:'Pairing failed. Is the boombox in pairing mode?'}};
const T=TEXTS[document.documentElement.lang]||TEXTS.de;
document.querySelectorAll('[data-t]').forEach(e=>e.textContent=T[e.dataset.t]);
document.querySelectorAll('[data-ph]').forEach(e=>e.placeholder=T[e.dataset.ph]);
const $=id=>document.getElementById(id);
async function api(path,body){const r=await fetch(path,{method:body===undefined?'GET':'POST',headers:{'Content-Type':'application/json','X-Requested-With':'cd-web'},body:body===undefined?undefined:JSON.stringify(body)});let j={};try{j=await r.json()}catch(e){}return {ok:r.ok,status:r.status,j}}
function el(tag,text,cls){const e=document.createElement(tag);if(text!==undefined)e.textContent=text;if(cls)e.className=cls;return e}
function say(t){$('msg').textContent=t;}
function render(d){
  last=d;
  const s=d.status,st=s.state||'idle';
  $('state').textContent=T[st]||st;
  $('state').className='state '+(st==='done'?'big-ok':st==='error'?'big-err':st==='idle'?'':'big-busy');
  const title=[s.artist,s.album].filter(Boolean).join(' – ');
  $('line1').textContent=title;
  $('line2').textContent=[s.cls,s.message].filter(Boolean).join(' · ');
  const bar=$('bar');if(st==='ripping'||st==='delivering'){bar.hidden=false;bar.value=Math.round((s.progress||0)*100)}else bar.hidden=true;
  const det=s.detect;$('detCard').hidden=!det;
  if(det){
    $('detTitle').textContent=[s.artist,s.album].filter(Boolean).join(' – ')+(det.year?' ('+det.year+')':'');
    $('detCls').textContent=T.type+': '+(s.cls||'?')+' – '+det.reason;
    const f=$('detFacts');f.replaceChildren();
    [[T.found_at,det.source],[T.dest,det.dests.map(x=>x.fmt.toUpperCase()+' → '+x.path).join(' | ')]].forEach(([k,v])=>{const li=el('li');li.appendChild(el('span',k+': ','sub'));li.appendChild(el('span',v));f.appendChild(li)});
    const hint=s.library?T.already+s.library:det.hint;
    $('detHint').hidden=!hint;$('detHint').textContent=hint||'';
    $('detLib').hidden=!s.library&&!d.force;
    const fb=$('forceBtn');fb.textContent=d.force?T.force_on:T.force_off;fb.className=d.force?'on':'';
    const fix=$('detFix');fix.hidden=st!=='ripping';
    if(st==='ripping'){
      const corr=d.correction||{};
      const detKey=Object.keys(d.classes).find(k=>d.classes[k]===s.cls);
      const dc=$('detChoices');dc.replaceChildren();
      Object.entries(d.classes).forEach(([k,v])=>{const b=el('button',v,k===(corr.cls||detKey)?'on':'');b.disabled=!det.choices.includes(k);
        b.onclick=async()=>{const r=await api('/api/correct',{cls:k===detKey?null:k,release:corr.release||''});$('detMsg').textContent=r.j.error||T.noted;load()};dc.appendChild(b)});
      $('detMsg').textContent=corr.release?T.rel_noted+(corr.cls?T.cls_changed:''):corr.cls?T.cls_noted:'';
    }
  }
  const busy=['reading','ripping','delivering'].includes(st);
  $('eject').disabled=busy;$('cancel').hidden=!['reading','ripping'].includes(st);$('flush').disabled=busy;
  const m=$('mounts');m.replaceChildren();d.mounts.forEach(x=>{const li=el('li');li.appendChild(el('span','','dot '+(x.ok===null?'':x.ok?'ok':'bad')));li.appendChild(el('span',x.path+(x.ok===null?T.checking:x.ok?T.reachable:T.unreachable)));m.appendChild(li)});
  const jobs=$('jobs');jobs.replaceChildren();$('pendingCard').hidden=!d.jobs.length;
  d.jobs.forEach(j=>{const li=el('li');li.appendChild(el('div',j.artist+' – '+j.album));li.appendChild(el('div',(j.failed?T.failed_job:j.cls+T.waiting_job)+j.job,'sub'));
    if(!j.failed){const inp=el('input');inp.placeholder=T.relabel_ph;li.appendChild(inp);const b=el('button',T.relabel);b.onclick=async()=>{say(T.working);const r=await api('/api/relabel',{job:j.job,release:inp.value});say(r.j.error||r.j.message||'ok');load()};li.appendChild(b)}
    jobs.appendChild(li)});
  const at=$('attach');at.replaceChildren();$('attachCard').hidden=!d.attach.length;
  d.attach.forEach(a=>{const li=el('li');const l=el('a',a.title+' ('+a.date+')');l.href=a.url;l.target='_blank';l.rel='noopener';li.appendChild(l);at.appendChild(li)});
  const h=$('hist');h.replaceChildren();if(!d.history.length)h.appendChild(el('li',T.nothing,'sub'));
  d.history.forEach(x=>{const li=el('li');li.appendChild(el('div',x.artist+' – '+x.album));li.appendChild(el('div',x.time+' · '+x.cls,'sub'));h.appendChild(li)});
}
async function load(){try{const r=await api('/api/status');if(r.ok)render(r.j)}catch(e){$('state').textContent=T.offline}}
// Speaker: cd-bt behind /api/bt/ (passed through by this server)
function spkMsg(t){$('spkMsg').textContent=t||''}
async function spkLoad(){
  const box=$('spkState');box.replaceChildren();
  let r;try{r=await api('/api/bt/status')}catch(e){r={ok:false}}
  if(!r.ok){box.appendChild(el('span',T.spk_unavail,'sub'));$('spkScan').disabled=true;$('spkForget').disabled=true;return}
  const sp=r.j.speaker||{};
  if(sp.address&&sp.paired!==false){const li=el('div');li.appendChild(el('span','','dot '+(sp.connected?'ok':'')));
    li.appendChild(el('span',T.spk_paired+(sp.name||sp.address)+(sp.connected?T.spk_connected:T.spk_off)));box.appendChild(li);$('spkForget').hidden=false}
  else{box.appendChild(el('span',T.spk_none,'sub'));$('spkForget').hidden=true}
}
$('spkScan').onclick=async()=>{
  const b=$('spkScan');b.disabled=true;spkMsg(T.spk_searching);const list=$('spkList');list.replaceChildren();
  const r=await api('/api/bt/scan',{});b.disabled=false;
  const devs=(r.j.devices||[]).filter(d=>!d.paired||d.audio);
  spkMsg(devs.length?'':T.spk_found_none);
  devs.forEach(d=>{const li=el('li','', 'dev');li.appendChild(el('span',(d.name||T.spk_unknown)+(d.audio?' ♪':'')));
    const p=el('button',T.spk_pair);p.onclick=async()=>{p.disabled=true;spkMsg(T.spk_pairing);const q=await api('/api/bt/pair',{address:d.address});
      spkMsg(q.ok?T.spk_done:(q.j.code==='pair_failed'?T.spk_pair_failed:(q.j.error||'')));if(q.ok)list.replaceChildren();p.disabled=false;spkLoad()};
    li.appendChild(p);list.appendChild(li)});
};
$('spkForget').onclick=async()=>{const r=await api('/api/bt/forget',{});spkMsg(r.ok?T.spk_forgot:(r.j.error||''));spkLoad()};
let last={};
$('forceBtn').onclick=async()=>{await api('/api/force',{on:!last.force});load()};
$('detSet').onclick=async()=>{const c=last.correction||{};const r=await api('/api/correct',{cls:c.cls||null,release:$('detRel').value});if(r.ok)$('detRel').value='';else $('detMsg').textContent=r.j.error;load()};
$('cancel').onclick=async()=>{$('cancel').disabled=true;const r=await api('/api/cancel',{});$('cancel').disabled=false;say(r.j.error||T.cancelled);load()};
$('eject').onclick=async()=>{const r=await api('/api/eject',{});say(r.j.error||T.ejected)};
$('flush').onclick=async()=>{const r=await api('/api/flush',{});say(r.j.error||r.j.message);};
load();spkLoad();setInterval(()=>{if(!document.hidden)load()},2000);
</script></body></html>
"""


def main():
    cfg = load_conf()
    Handler.cfg = cfg
    Handler.mounts = Mounts(cfg["MOUNT_POINTS"])
    port = int(cfg["WEB_PORT"])
    srv = ThreadingHTTPServer(("0.0.0.0", port), Handler)
    log(f"cd-web listening on port {port}")
    srv.serve_forever()


if __name__ == "__main__":
    main()
