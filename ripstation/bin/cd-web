#!/usr/bin/env python3
"""cd-web: small web UI for the CD ripper (status, what was detected + corrections, eject, retry, fix metadata).

Pure standard library. Reads /run/cd-ripper/status.json (written by cd-rip) and talks to cd-rip
through files and subprocesses. Listens on WEB_PORT (default 80). Optional HTTP basic auth:
set WEB_PASSWORD in /etc/cd-ripper/cd-ripper.conf (user name: cd)."""
import base64
import hmac
import json
import os
import re
import signal
import struct
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request
import zlib
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

RUN_DIR = Path(os.environ.get("CDRIP_RUN_DIR", "/run/cd-ripper"))
CONF = os.environ.get("CDRIP_CONF", "/etc/cd-ripper/cd-ripper.conf")
CD_RIP = os.environ.get("CDRIP_BIN", "/usr/local/bin/cd-rip")
DEFAULTS = {"STATE_DIR": "/var/lib/cd-ripper", "WEB_PORT": "80", "WEB_PASSWORD": "", "BT_PORT": "8081", "LANG": "de",
            "MOUNT_POINTS": "/mnt/nas", "DEVICE": "/dev/sr0"}
CLASSES = {"KIDS": "Kinderhörspiel", "SPOKEN": "Hörbuch", "MUSIC": "Musik", "UNSORTED": "Unsortiert"}
BUSY = ("reading", "ripping", "delivering")
JOB_RE = re.compile(r"^\d{8}-\d{6}-[0-9a-f]{8}$")
UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.I)


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def load_conf(path=CONF):
    cfg = dict(DEFAULTS)
    try:
        for line in Path(path).read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, v = line.split("=", 1)
                cfg[k.strip()] = v.strip().strip("\"'")
    except OSError:
        pass
    return cfg


# ----------------------------------------------------------------------------- data

class Mounts:
    """Checks the NAS mounts in the background: touching an automount can block for ~30 s."""

    def __init__(self, points):
        self.points = points.split()
        self.state = {p: {"ok": None, "checked": 0} for p in self.points}
        threading.Thread(target=self._loop, daemon=True).start()

    def _loop(self):
        while True:
            for p in self.points:
                try:
                    os.listdir(p)
                    ok = os.path.ismount(p)
                except OSError:
                    ok = False
                self.state[p] = {"ok": ok, "checked": time.time()}
            time.sleep(30)

    def snapshot(self):
        return [{"path": p, **self.state[p]} for p in self.points]


def read_json(path, default):
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return default



def list_jobs(cfg, busy=False):
    """Waiting jobs. A job without meta.json is a failed rip, except the newest one while a rip is running."""
    out = []
    dirs = [d for d in sorted((Path(cfg["STATE_DIR"]) / "jobs").glob("*")) if JOB_RE.match(d.name)]
    active = next((d for d in reversed(dirs) if not (d / "meta.json").exists()), None) if busy else None
    for d in dirs:
        if d == active:
            continue
        meta = read_json(d / "meta.json", None)
        if meta:
            out.append({"job": d.name, "artist": meta.get("artist", "?"), "album": meta.get("album", "?"),
                        "cls": CLASSES.get(meta.get("cls"), "?"), "failed": False})
        else:
            out.append({"job": d.name, "artist": "?", "album": "Rip fehlgeschlagen", "cls": "", "failed": True})
    return out


def tail_lines(path, n):
    try:
        return Path(path).read_text(encoding="utf-8").splitlines()[-n:]
    except OSError:
        return []


def history(cfg, n=15):
    rows = []
    for line in reversed(tail_lines(Path(cfg["STATE_DIR"]) / "done.tsv", n)):
        p = line.split("\t")
        if len(p) >= 6:
            rows.append({"time": p[0], "cls": CLASSES.get(p[3], p[3]), "artist": p[4], "album": p[5]})
    return rows


def attach_links(cfg, n=10):
    rows = []
    for line in reversed(tail_lines(Path(cfg["STATE_DIR"]) / "attach-links.txt", n)):
        p = line.split("\t")
        if len(p) == 3 and p[2].startswith("https://musicbrainz.org/cdtoc/attach?"):
            rows.append({"date": p[0], "title": p[1], "url": p[2]})
    return rows


def rip_pid():
    """The pid of the running cd-rip, or None. cd-rip holds a lock on RUN_DIR/lock for as long as it runs, and the
    kernel lists it in /proc/locks: gone exactly when the process is, whatever killed it."""
    try:
        st = os.stat(RUN_DIR / "lock")
        locks = Path("/proc/locks").read_text()
    except OSError:
        return None
    for line in locks.splitlines():
        f = line.split()
        if len(f) >= 6 and f[1] == "FLOCK" and f[0][-1] == ":":
            try:
                _maj, _min, ino = f[5].split(":")
                if int(ino) == st.st_ino:
                    return int(f[4])
            except ValueError:
                continue
    return None


def current_status():
    """status.json, except that a read or rip whose cd-rip has died (crash, power cut, kill) shows as idle."""
    st = read_json(RUN_DIR / "status.json", {"state": "idle"})
    if st.get("state") in ("reading", "ripping") and rip_pid() is None:
        return {"state": "idle", "message": "Abgebrochen"}
    return st


def build_status(cfg, mounts):
    st = current_status()
    return {"status": st, "classes": CLASSES, "jobs": list_jobs(cfg, st.get("state") in BUSY),
            "correction": read_json(RUN_DIR / "correction", {}),
            "force": (RUN_DIR / "force").exists(),
            "history": history(cfg), "attach": attach_links(cfg), "mounts": mounts.snapshot(),
            "now": time.time()}


# ----------------------------------------------------------------------------- actions

def run_cmd(cmd, timeout):
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode, (p.stdout + p.stderr).strip().splitlines()[-6:]
    except subprocess.TimeoutExpired:
        return 124, ["Zeitüberschreitung"]


def handle_post(path, data, cfg):
    """Returns (http_status, json_body)."""
    state = current_status().get("state", "idle")
    if path == "/api/cancel":
        pid = rip_pid()
        if state not in ("reading", "ripping") or pid is None:
            return 409, {"error": "Es wird gerade keine CD gelesen"}
        os.kill(pid, signal.SIGTERM)  # cd-rip stops cdparanoia, throws the half disc away and ejects
        return 200, {"ok": True}
    if path == "/api/force":
        RUN_DIR.mkdir(parents=True, exist_ok=True)
        if data.get("on"):
            (RUN_DIR / "force").write_text("1")
        else:
            (RUN_DIR / "force").unlink(missing_ok=True)
        return 200, {"ok": True}
    if path == "/api/correct":
        if state != "ripping":
            return 409, {"error": "Korrigieren geht nur, solange die CD gerippt wird"}
        st = read_json(RUN_DIR / "status.json", {})
        corr = {}
        cls = data.get("cls")
        if cls:
            if cls not in CLASSES:
                return 400, {"error": "unbekannte Klasse"}
            if cls not in (st.get("detect") or {}).get("choices", []):
                return 400, {"error": "Dafür wird für diese CD nicht das richtige Format gerippt"}
            if CLASSES[cls] != st.get("cls"):
                corr["cls"] = cls
        if data.get("release"):
            m = UUID_RE.search(str(data["release"]))
            if not m:
                return 400, {"error": "keine MusicBrainz-ID gefunden"}
            corr["release"] = m.group(0).lower()
        if corr:
            (RUN_DIR / "correction").write_text(json.dumps(corr), encoding="utf-8")
        else:
            (RUN_DIR / "correction").unlink(missing_ok=True)
        return 200, {"ok": True}
    if path == "/api/eject":
        if state in BUSY:
            return 409, {"error": "Es läuft gerade ein Vorgang"}
        rc, out = run_cmd(["eject", cfg["DEVICE"]], 20)
        return (200, {"ok": True}) if rc == 0 else (500, {"error": " ".join(out)})
    if path == "/api/flush":
        if state in BUSY:
            return 409, {"error": "Es läuft gerade ein Vorgang"}
        threading.Thread(target=run_cmd, args=([CD_RIP, "--flush"], 600), daemon=True).start()
        return 200, {"ok": True, "message": "Kopieren gestartet"}
    if path == "/api/relabel":
        job = str(data.get("job", ""))
        m = UUID_RE.search(str(data.get("release", "")))
        if not JOB_RE.match(job) or not (Path(cfg["STATE_DIR"]) / "jobs" / job / "meta.json").exists():
            return 400, {"error": "unbekannter Auftrag"}
        if not m:
            return 400, {"error": "keine MusicBrainz-ID gefunden"}
        if state in BUSY:
            return 409, {"error": "Es läuft gerade ein Vorgang"}
        rc, out = run_cmd([CD_RIP, "--relabel", str(Path(cfg["STATE_DIR"]) / "jobs" / job), "--release",
                           m.group(0).lower()], 300)
        return (200, {"ok": True, "message": out[-1] if out else "fertig"}) if rc == 0 else (500, {"error": " ".join(out)})
    return 404, {"error": "unbekannt"}


# ----------------------------------------------------------------------------- icon

ICON_SVG = (
    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100">'
    '<rect width="100" height="100" rx="22" fill="#2563eb"/>'
    '<circle cx="50" cy="50" r="34" fill="#fff"/><circle cx="50" cy="50" r="15" fill="#c7d7fb"/>'
    '<circle cx="50" cy="50" r="6" fill="#2563eb"/></svg>')


def icon_png(size=180):
    """The same icon as PNG (phones want one for home-screen bookmarks); drawn here to stay dependency free."""
    layers = [(0.34, (255, 255, 255)), (0.15, (199, 215, 251)), (0.06, (37, 99, 235))]  # radius, colour (outer first)
    rows = bytearray()
    ss = 3
    for y in range(size):
        rows.append(0)
        for x in range(size):
            acc = [0, 0, 0]
            for sy in range(ss):
                for sx in range(ss):
                    dx, dy = (x + (sx + .5) / ss) / size - .5, (y + (sy + .5) / ss) / size - .5
                    r = (dx * dx + dy * dy) ** .5
                    col = (37, 99, 235)
                    for rad, c in layers:
                        if r <= rad:
                            col = c
                    for i in range(3):
                        acc[i] += col[i]
            rows += bytes(a // (ss * ss) for a in acc)

    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data))
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(bytes(rows), 9)) + chunk(b"IEND", b""))


_png_cache = []


def cached_png():
    if not _png_cache:
        _png_cache.append(icon_png())
    return _png_cache[0]


# ----------------------------------------------------------------------------- HTTP

class Handler(BaseHTTPRequestHandler):
    cfg = None
    mounts = None
    server_version = "cd-web"

    def log_message(self, fmt, *args):
        pass

    def _send(self, code, body, ctype="application/json; charset=utf-8"):
        raw = body if isinstance(body, bytes) else (body if isinstance(body, str) else json.dumps(body)).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Security-Policy", "default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'")
        self.end_headers()
        self.wfile.write(raw)

    def _authorized(self):
        pw = self.cfg["WEB_PASSWORD"]
        if not pw:
            return True
        header = self.headers.get("Authorization", "")
        if header.startswith("Basic "):
            try:
                user, _, given = base64.b64decode(header[6:]).decode().partition(":")
                if user == "cd" and hmac.compare_digest(given, pw):
                    return True
            except (ValueError, UnicodeDecodeError):
                pass
        self.send_response(401)
        self.send_header("WWW-Authenticate", 'Basic realm="CD-Ripper"')
        self.send_header("Content-Length", "0")
        self.end_headers()
        return False

    def _proxy_bt(self, body=None):
        """/api/bt/* goes to cd-bt on this machine (same login), so the page needs no second origin."""
        req = urllib.request.Request(f"http://127.0.0.1:{self.cfg['BT_PORT']}{self.path}", data=body,
                                     method="POST" if body is not None else "GET")
        for h in ("Authorization", "X-Requested-With", "Content-Type"):
            if self.headers.get(h):
                req.add_header(h, self.headers[h])
        try:
            with urllib.request.urlopen(req, timeout=70) as r:
                return self._send(r.status, r.read())
        except urllib.error.HTTPError as e:
            return self._send(e.code, e.read())
        except OSError:
            return self._send(502, {"error": "cd-bt not reachable"})

    def do_GET(self):
        if not self._authorized():
            return
        if self.path.startswith("/api/bt/"):
            return self._proxy_bt()
        if self.path in ("/", "/index.html"):
            lang = "en" if self.cfg.get("LANG", "de") == "en" else "de"
            self._send(200, PAGE.replace("__LANG__", lang, 1), "text/html; charset=utf-8")
        elif self.path == "/api/status":
            self._send(200, build_status(self.cfg, self.mounts))
        elif self.path in ("/icon.svg", "/favicon.svg"):
            self._send(200, ICON_SVG, "image/svg+xml")
        elif self.path in ("/apple-touch-icon.png", "/apple-touch-icon-precomposed.png", "/favicon.ico"):
            self._send(200, cached_png(), "image/png")
        else:
            self._send(404, {"error": "not found"})

    def do_POST(self):
        if not self._authorized():
            return
        if self.headers.get("X-Requested-With") != "cd-web":  # cross-site forms cannot set this header
            return self._send(403, {"error": "forbidden"})
        if self.path.startswith("/api/bt/"):
            length = int(self.headers.get("Content-Length", "0") or 0)
            return self._proxy_bt(self.rfile.read(min(length, 10000)) or b"{}")
        try:
            length = int(self.headers.get("Content-Length", "0"))
            data = json.loads(self.rfile.read(min(length, 10000)) or b"{}")
            if not isinstance(data, dict):
                raise ValueError
        except ValueError:
            return self._send(400, {"error": "bad request"})
        code, body = handle_post(self.path, data, self.cfg)
        self._send(code, body)


